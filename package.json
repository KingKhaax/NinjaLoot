{
  "name": "ninjaloot",
  "productName": "NinjaLoot",
  "version": "1.8.19",
  "description": "NinjaLoot: gráficas de mejoras de objetos a partir de simulaciones de Raidbots",
  "main": "main.js",
  "author": "sr.kitkat",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "assets": "node tools/build-assets.mjs",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.kingkhaax.ninjaloot",
    "productName": "NinjaLoot",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "build/app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "guid": "af6f40ab-cd79-500d-85bf-ccd9a5b211a4",
      "artifactName": "NinjaLoot v${version} Setup.${ext}"
    },
    "portable": {
      "artifactName": "NinjaLoot v${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "KingKhaax",
      "repo": "NinjaLoot"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
